# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-real-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins that are trusted for unsafe (POST/PUT/DELETE) requests + CSRF cookie is read from here too
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Database (Postgres) ---
POSTGRES_DB=safarchin
POSTGRES_USER=safarchin
POSTGRES_PASSWORD=safarchin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis (cache, rate limiting, Celery broker) ---
# NOTE: intentionally NOT named CELERY_BROKER_URL / CELERY_RESULT_BACKEND -- Celery
# special-cases those exact OS env var names at app-init time and they silently win
# over config_from_object(settings), which broke our django-db result backend.
# Host port 6380, not the default 6379 -- see docker-compose.yml's redis service comment;
# another local process binding 6379 can silently reset every connection.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_REDIS_URL=redis://localhost:6380/1
# Celery task results are stored via django-db (django_celery_results), not Redis.

# --- Email (local dev default: console backend, prints emails to the runserver log) ---
# Switch EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend + set the SMTP_* vars for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Safarchin <no-reply@safarchin.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASSWORD=

# --- LLM (langchain-openai) ---
# REQUIRED to enable real plan generation. "5.6-luna" as requested resolves to the real
# public OpenAI model id "gpt-5.6-luna" -- verify against your provider's model list before relying on it.
# Never leave this silently pointing at a different model than what you configured.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5.6-luna
# Only set if you're routing through a compatible gateway/proxy instead of api.openai.com directly.
OPENAI_BASE_URL=

# --- LangSmith tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=safarchin

# --- Tavily web research ---
TAVILY_API_KEY=

# --- Neshan (maps/places/routing) ---
NESHAN_API_KEY=
NESHAN_WEB_SDK_KEY=

# --- Trip scheduling ---
DEFAULT_TRIP_TIMEZONE=Asia/Tehran
